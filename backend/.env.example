# Copy to .env (or export these) for local development.
DATABASE_URL=postgres://postgres@localhost:5432/kwil
APP_ENV=development
API_PORT=8080
BLOG_PORT=8081
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Blogs are served at http://<site-slug>.localhost:8081 locally.
BLOG_BASE_DOMAIN=localhost
AUTH_MODE=dev
# demo = deterministic stand-in writer, no key needed. openrouter = real models.
AI_PROVIDER=demo
# OPENROUTER_API_KEY=
QUEUE=local
STORAGE=local
STORAGE_DIR=./data/uploads
CDN=none
MAILER=outbox
